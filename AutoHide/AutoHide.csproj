<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AutoHide</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TaleSpire" Version="1.6.0" />
    <PackageReference Include="Talespire.BepInEx" Version="5.4.22" />
    <PackageReference Include="TaleSpire.SetInjectionFlagPlugin" Version="3.4.1" />
    <!-- NuGet stops at 3.1.3, but its GM-block menu API is byte-identical to 3.2.1, and 3.2.1
         is the version that actually runs on TaleSpire 1.6.0. Compile here, ship against that. -->
    <PackageReference Include="TaleSpire.RadialUI" Version="3.1.3" />
  </ItemGroup>
</Project>
